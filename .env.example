# Email Configuration for Order Confirmations
# Gmail: Use an App Password (https://support.google.com/accounts/answer/185833)
# Other providers: Use your service-specific password

EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password-or-password

# Support Email (for customer inquiries)
SUPPORT_EMAIL=support@gosiekartel.com

# Admin Token (for order status updates)
ADMIN_TOKEN=your-secure-admin-token-here

# Port Configuration
PORT=3000

# Database Configuration (optional, for future use)
# DATABASE_URL=mongodb://localhost:27017/gosie-kartel
